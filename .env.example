# ──────────────────────────────────────────────────────────────
# BRPix Digital — Credenciais do backend (NUNCA exponha no frontend)
# Configure no painel da Vercel: Settings → Environment Variables
# ──────────────────────────────────────────────────────────────

BRPIX_SECRET_KEY=sua_chave_secreta_aqui
BRPIX_COMPANY_ID=seu_company_id_aqui

# Domínio do projeto (ex: https://seusite.com.br) — usado para CORS e postbackUrl
ALLOWED_ORIGIN=https://seusite.com.br

# ──────────────────────────────────────────────────────────────
# Vercel KV (Upstash Redis) — gerado automaticamente pelo Vercel CLI
# Execute: vercel link && vercel env pull .env.local
# ──────────────────────────────────────────────────────────────

KV_REST_API_URL=https://YOUR_KV_ENDPOINT.upstash.io
KV_REST_API_TOKEN=SEU_TOKEN_AQUI
KV_REST_API_READ_ONLY_TOKEN=SEU_READ_ONLY_TOKEN_AQUI
